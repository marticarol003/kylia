# =============================================================================
# Kylia · variables de entorno
# Copia este archivo a .env.local (no se commitea) y rellena los valores reales.
# En producción se configuran en Vercel (Project Settings → Environment Variables).
#
# Esta lista es EXACTA: solo las variables que api/*.js lee de verdad (process.env).
# Sin Stripe/Telegram/Beehiiv/Next — no están cableados en el código.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase · Postgres (fuente de datos, vía PostgREST con la service key)
# https://supabase.com/dashboard/project/_/settings/api
# SUPABASE_SERVICE_KEY = la service_role key (solo backend, NUNCA en cliente).
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# -----------------------------------------------------------------------------
# Copernicus Data Space · Sentinel-2 (NDVI / NDMI / NDRE) — api/sentinel.js
# Registro gratuito en https://dataspace.copernicus.eu
# OAuth client credentials en User Settings → OAuth clients.
# -----------------------------------------------------------------------------
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Diario B · cron que congela la decisión de riego del piloto silencioso
# api/diario-b.js — por defecto DRY-RUN; DIARIO_B_LIVE=1 habilita la escritura.
# DIARIO_B_TOKEN (opcional) autentica la llamada al cron.
# -----------------------------------------------------------------------------
DIARIO_B_LIVE=
DIARIO_B_TOKEN=

# -----------------------------------------------------------------------------
# Panel de pilotos · /pilotos (admin) — api/campo.js vista=pilotos
# PILOTOS_KEY: clave de acceso. PILOTOS_JSON: configuración opcional.
# -----------------------------------------------------------------------------
PILOTOS_KEY=
PILOTOS_JSON=

# -----------------------------------------------------------------------------
# Sesión firmada · api/_sesion.js
# La cookie que emite el canjeo del enlace por correo, para que las APIs sepan
# QUIÉN pregunta y no solo por quién. Cadena aleatoria larga (32+ bytes):
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Sin configurar NO se emite ninguna sesión y todo funciona como antes (fail-safe
# a propósito: un despliegue sin esta variable no puede dejar a nadie fuera).
# Cambiarla invalida todas las sesiones vivas — la gente tendrá que volver a
# pedir su enlace.
# -----------------------------------------------------------------------------
SESION_SECRET=

# -----------------------------------------------------------------------------
# Cobro · Stripe (api/pago.js + api/_stripe.js)
# STRIPE_SECRET_KEY:     sk_live_… / sk_test_…. Sin ella el cobro está APAGADO
#                        entero y /api/pago responde stripe_no_configurado.
# STRIPE_WEBHOOK_SECRET: whsec_… del endpoint que crees en el panel de Stripe
#                        apuntando a https://kylia.app/api/pago. Sin ella NO se
#                        activa ninguna suscripción: la firma es lo único que
#                        distingue a Stripe de cualquiera que diga que ha pagado.
#
# ⚠️ Antes de encender esto: Vercel Hobby prohíbe el uso comercial (hay que pasar
#    a plan comercial), hay que ejecutar db/suscripciones-2026-08-13.sql para que
#    los pilotos de 2026 queden marcados como gratuitos de por vida, y Stripe
#    tiene que entrar como subencargado en la política de privacidad.
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# IA de texto · recomendaciones (api/ia.js) e informe científico
# GEMINI_API_KEY: free tier (obligatoria para el texto).
# ANTHROPIC_API_KEY: opcional, capa premium del informe (cascada Claude→Gemini→plantilla).
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Email · Resend (feedback in-app + recordatorio vespertino del diario)
# Dominio remitente verificado en Resend.
# -----------------------------------------------------------------------------
RESEND_API_KEY=
RECORDATORIO_FROM_EMAIL=
RECORDATORIO_TOKEN=

# -----------------------------------------------------------------------------
# Enrutado de leads y feedback (opcionales: si faltan, esos POST solo loguean)
# -----------------------------------------------------------------------------
FEEDBACK_FORWARD_EMAIL=
FEEDBACK_WEBHOOK_URL=
WAITLIST_FORWARD_EMAIL=
WAITLIST_WEBHOOK_URL=
